# AIFSHeavyRain AI/provider configuration template (safe for Git tracking).
# This example is not loaded by the pipeline; the runtime reads envi/api_keys.env.
# To initialize locally, copy this file to envi/api_keys.env and set credentials
# only in that ignored, private file. Never commit actual credentials.
#
# Runtime provider selection. CLI options override these values.
# AIFS_AI_PROVIDER="openai"
AIFS_AI_PROVIDER="codex_cli"

# Model selection: the runtime reads model IDs from envi/api_keys.env.
# Change model IDs in the private runtime file; do not change Python code.
AIFS_MODEL_STEP04="gpt-6-luna"
AIFS_MODEL_STEP07="gpt-6-luna"
AIFS_MODEL_STEP08="gpt-6.1-sol"

# Official OpenAI Responses API configuration.
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"  # example only; never commit a real key
OPENAI_IMAGE_DETAIL="original"
OPENAI_REASONING_EFFORT_OBSERVATION="none"
OPENAI_REASONING_EFFORT_GROUP_SUMMARY="none"
OPENAI_REASONING_EFFORT_CANDIDATE_DISCOVERY="high"
OPENAI_REASONING_EFFORT_CANDIDATE_PLAN="low"
# Legacy shared Pass2 fallback. Used only when the stage-specific variable is absent.
OPENAI_REASONING_EFFORT_PASS2="high"

# Step07 VLM Check Assessment
OPENAI_REASONING_EFFORT_PASS2_CHECK="high"

# Step08 Candidate Synthesis
OPENAI_REASONING_EFFORT_PASS2_SYNTHESIS="high"
# Used only when Step08 regenerates a failed semantic/narrative unit.
OPENAI_REASONING_EFFORT_PASS2_SYNTHESIS_REPAIR="xhigh"

# Codex CLI configuration. Used when AIFS_AI_PROVIDER="codex_cli".
CODEX_BIN="/home/ubuntu/.local/bin/codex"
CODEX_SANDBOX="read-only"
CODEX_EPHEMERAL="true"
CODEX_REASONING_EFFORT_OBSERVATION="none"
CODEX_REASONING_EFFORT_GROUP_SUMMARY="none"
CODEX_REASONING_EFFORT_CANDIDATE_DISCOVERY="medium"
CODEX_REASONING_EFFORT_CANDIDATE_PLAN="medium"
# Legacy shared Pass2 fallback. Used only when the stage-specific variable is absent.
CODEX_REASONING_EFFORT_PASS2="medium"
CODEX_REASONING_EFFORT_PASS2_CHECK="medium"
CODEX_REASONING_EFFORT_PASS2_SYNTHESIS="medium"
CODEX_REASONING_EFFORT_PASS2_SYNTHESIS_REPAIR="high"
