# AIFSHeavyRain 운영 경로 설정
#
# 이 파일에는 운영에 필요한 경로와 실행 설정만 정의합니다.
# API 키는 이 파일에 저장하지 않으며, API/provider 설정은 api_keys.env에서 관리합니다.

# ----------------------------------------------------------------------------
# 1. 프로그램 위치 / Python
# ----------------------------------------------------------------------------
AIFS_ROOT="/home/ubuntu/AIFSHeavyRain"

# Conda 실행환경
AIFS_CONDA_ROOT="/home/ubuntu/miniconda3"
AIFS_CONDA_ENV="aifsheavyrain"

# Python 실행파일
AIFS_PYTHON="${AIFS_CONDA_ROOT}/envs/${AIFS_CONDA_ENV}/bin/python"

# 프로그램 디렉터리
AIFS_SCRIPT_DIR="${AIFS_ROOT}/scripts"
AIFS_FUNC_DIR="${AIFS_ROOT}/func"

# ----------------------------------------------------------------------------
# 2. 입력 / 중간 / 최종 산출물 디렉터리
# ----------------------------------------------------------------------------
AIFS_DAIN_DIR="${AIFS_ROOT}/dain"
AIFS_DAIO_DIR="${AIFS_ROOT}/daio"
AIFS_DAOU_DIR="${AIFS_ROOT}/daou"

# ----------------------------------------------------------------------------
# 3. 운영 설정 / 로그 / 임시 디렉터리
# ----------------------------------------------------------------------------
AIFS_DABA_DIR="${AIFS_ROOT}/daba"
AIFS_PROMPTS_DIR="${AIFS_ROOT}/prompts"
AIFS_ENVI_DIR="${AIFS_ROOT}/envi"
AIFS_LOG_DIR="${AIFS_ROOT}/logs"
AIFS_TMP_DIR="${AIFS_ROOT}/tmp"

# Step04, Step07, Step08에서 사용하는 API/provider 설정 파일
AIFS_API_ENV_FILE="${AIFS_ENVI_DIR}/api_keys.env"

# ----------------------------------------------------------------------------
# 4. 웹 제공 디렉터리
# ----------------------------------------------------------------------------
# Step10 최종 산출물은 daou/<init>/에 영구 보존합니다.
# Step10이 정상 완료되면 웹 제공용 사본을 다음 위치에 복사합니다.
#   ${AIFS_WEB_ROOT}/<init>/
# /var/www/html에 이미 존재하는 파일은 삭제하지 않습니다.
AIFS_WEB_ROOT="/var/www/html"
