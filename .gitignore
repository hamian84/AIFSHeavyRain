# 운영 환경설정: 허용한 두 파일만 Git 추적
/envi/*
!/envi/pipeline.env
!/envi/api_keys.env.example

# 일반 환경변수 파일 제외
.env
.env.*

# 실행 결과 및 로그
/daio/
/tmp/
/logs/
/outputs/
/artifacts/
/results/

# Python 자동 생성 파일
__pycache__/
*.pyc
.pytest_cache/

# 기상 원시자료
*.grib
*.grib2
*.grb
*.grb2
*.nc

# 임시 파일
*.log
*.bak
*.backup

# AIFS 입력 및 생성자료
/dain/
/daou/

# 웹 게시 디렉터리 심볼릭 링크
/html

# 테스트 파일
/tests/

# 테스트용 파이프라인 실행 스크립트
/scripts/zrun_pipeline.ksh
/scripts/zzrun_pipeline.ksh
/scripts/his_run_pipeline.ksh
