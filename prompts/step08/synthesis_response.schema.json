{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIFSHeavyRain Pass2 candidate synthesis response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "hypothesis_assessments",
    "forecaster_question_answers",
    "signal_assessment",
    "uncertainties",
    "final_assessment",
    "revision",
    "operational_brief",
    "operational_guidance"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis_assessment"
      }
    },
    "forecaster_question_answers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forecaster_question_answer"
      }
    },
    "signal_assessment": {
      "$ref": "#/$defs/signal_assessment"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_assessment": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "operational_guidance": {
      "$ref": "#/$defs/operational_guidance"
    },
    "operational_brief": {
      "$ref": "#/$defs/operational_brief"
    }
  },
  "$defs": {
    "operational_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_action",
        "next_check",
        "interpretation_limit",
        "evidence_check_ids"
      ],
      "properties": {
        "current_action": {
          "type": "string",
          "minLength": 1
        },
        "next_check": {
          "type": "string",
          "minLength": 1
        },
        "interpretation_limit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "hypothesis_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "assessment",
        "evidence_check_ids",
        "quantitative_relation_ids",
        "rationale",
        "uncertainties"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "enum": [
            "supported",
            "partially_supported",
            "not_supported",
            "contradicted",
            "uncertain",
            "insufficient_evidence"
          ]
        },
        "evidence_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quantitative_relation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Step07에서 Python 사후검증을 통과한 정량관계 참조만 기록한다. 참조값은 <check_id>:<relation_id> 형식이며 새 정량관계를 생성하지 않는다."
        }
      }
    },
    "forecaster_question_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecaster_question_id",
        "answer",
        "evidence_check_ids",
        "quantitative_relation_ids",
        "uncertainties"
      ],
      "properties": {
        "forecaster_question_id": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "evidence_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quantitative_relation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Step07에서 Python 사후검증을 통과한 정량관계 참조만 기록한다. 참조값은 <check_id>:<relation_id> 형식이며 새 정량관계를 생성하지 않는다."
        }
      }
    },
    "signal_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_precipitation_status",
        "environment_support_status",
        "environment_persistence_status",
        "environment_persistence_evidence_check_ids",
        "direct_precipitation_assessment",
        "precursor_environment_assessment",
        "contradictory_evidence",
        "validated_precursor_evidence",
        "validated_spatiotemporal_alignment",
        "spatiotemporal_alignment_evidence_check_ids",
        "signal_evidence_check_ids",
        "physical_consistency_status",
        "physical_mechanism_summary",
        "mechanism_evidence",
        "monitoring_evidence",
        "monitoring_value",
        "operational_surface_reason",
        "operational_surface_decision"
      ],
      "properties": {
        "direct_precipitation_status": {
          "enum": [
            "confirmed",
            "partial",
            "not_confirmed",
            "insufficient_evidence"
          ]
        },
        "environment_support_status": {
          "enum": [
            "confirmed",
            "partial",
            "not_confirmed",
            "insufficient_evidence"
          ]
        },
        "signal_class": {
          "enum": [
            "direct_environment_supported",
            "direct_environment_conditional",
            "direct_environment_unsupported",
            "direct_environment_unresolved",
            "precursor_watch",
            "partially_supported",
            "rejected",
            "insufficient_evidence"
          ]
        },
        "direct_precipitation_assessment": {
          "type": "string",
          "minLength": 1
        },
        "precursor_environment_assessment": {
          "type": "string",
          "minLength": 1
        },
        "contradictory_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validated_precursor_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/precursor_evidence"
          }
        },
        "validated_spatiotemporal_alignment": {
          "type": "boolean"
        },
        "spatiotemporal_alignment_evidence_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "signal_evidence_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "operational_surface_decision": {
          "enum": [
            "surface",
            "do_not_surface",
            "not_applicable"
          ]
        },
        "physical_consistency_status": {
          "enum": [
            "coherent",
            "conditionally_coherent",
            "incoherent",
            "insufficient_evidence"
          ]
        },
        "physical_mechanism_summary": {
          "type": "string",
          "minLength": 1
        },
        "monitoring_value": {
          "enum": [
            "meaningful",
            "marginal",
            "low",
            "undetermined"
          ]
        },
        "operational_surface_reason": {
          "type": "string",
          "minLength": 1
        },
        "mechanism_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_evidence"
          },
          "description": "강수 발생·유지 메커니즘 판단에 사용한 Step07 근거 역할 객체. 직접 강수 presence anchor는 포함하지 않는다."
        },
        "monitoring_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision_evidence"
          },
          "description": "예보관 우선 확인 가치 판단에 사용한 Step07 근거 역할 객체. 직접 강수 presence anchor는 포함하지 않는다."
        },
        "environment_persistence_status": {
          "enum": [
            "confirmed",
            "limited",
            "insufficient_evidence",
            "not_applicable"
          ],
          "description": "핵심시각 환경 존재와 분리된 환경의 시간적 지속·강화 상태. confirmed=지속/강화 확인, limited=약화·분리 등 지속성 제한, insufficient_evidence=판단 근거 부족, not_applicable=환경 존재 판단 대상이 아님."
        },
        "environment_persistence_evidence_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "환경 지속성 판단에 실제 사용한 Step07 시간변화/지속성 Check ID."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validated_spatiotemporal_alignment": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "spatiotemporal_alignment_evidence_check_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "precursor_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "evidence_check_ids"
      ],
      "properties": {
        "category": {
          "enum": [
            "moisture_supply",
            "low_level_forcing",
            "mid_upper_forcing",
            "thermodynamic_support",
            "organization_persistence",
            "direct_precipitation"
          ]
        },
        "evidence_check_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revised_candidate_name",
        "candidate_name_revision_reason",
        "candidate_name_revision_evidence_check_ids",
        "revised_area",
        "revised_time_window"
      ],
      "properties": {
        "revised_candidate_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 60,
          "description": "GPT-6 Sol이 candidate_name_grounding_contract.allowed_display_names 중 선택한 최종 사용자 표시 후보명. Step04 원본 candidate_name은 provenance로 보존."
        },
        "candidate_name_revision_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 240,
          "description": "허용된 후보명 중 이 표시명을 선택한 기상학적·공간적 이유."
        },
        "candidate_name_revision_evidence_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "선택한 candidate_name_grounding_contract.name_option이 요구하는 Step07 근거 Check ID."
        },
        "revised_area": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "west",
            "east",
            "south",
            "north"
          ],
          "properties": {
            "west": {
              "type": "number"
            },
            "east": {
              "type": "number"
            },
            "south": {
              "type": "number"
            },
            "north": {
              "type": "number"
            }
          }
        },
        "revised_time_window": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "forecast_hour_start",
            "forecast_hour_end"
          ],
          "properties": {
            "forecast_hour_start": {
              "type": "integer"
            },
            "forecast_hour_end": {
              "type": "integer"
            }
          }
        }
      }
    },
    "decision_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "effect",
        "reason"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "supporting",
            "limiting",
            "mixed",
            "context"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operational_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_signal",
        "key_limitation",
        "next_check",
        "evidence_check_ids"
      ],
      "properties": {
        "key_signal": {
          "type": "string",
          "minLength": 1
        },
        "key_limitation": {
          "type": "string",
          "minLength": 1
        },
        "next_check": {
          "type": "string",
          "minLength": 1
        },
        "evidence_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
