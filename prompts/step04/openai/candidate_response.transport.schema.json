          "analysis_envelope_request",
          "candidate_area",
          "candidate_id",
          "candidate_name",
          "confidence",
          "detection_basis",
          "diagnostic_plan",
          "hypothesis",
          "opposing_reasons",
          "peak_forecast_hours",
          "precipitation_signal_status",
          "precursor_signal_categories",
          "precursor_spatiotemporal_overlap",
          "candidate_unit_type",
          "discovery_order",
          "related_overview_asset_ids",
