{
  "title": "AI Pass1 후보 탐색 단계",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_name": {
            "type": "string",
            "minLength": 1
          },
          "candidate_area": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "west": {
                "type": "number"
              },
              "east": {
                "type": "number"
              },
              "south": {
                "type": "number"
              },
              "north": {
                "type": "number"
              }
            },
            "required": [
              "east",
              "north",
              "south",
              "west"
            ]
          },
          "time_window": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "forecast_hour_start": {
                "type": "integer",
                "minimum": 0
              },
              "forecast_hour_end": {
                "type": "integer",
                "minimum": 0
              },
              "valid_time_start_utc": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "valid_time_end_utc": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "forecast_hour_end",
              "forecast_hour_start",
              "valid_time_end_utc",
              "valid_time_start_utc"
            ]
          },
          "peak_forecast_hours": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "maxItems": 5
          },
          "signal_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 6
          },
          "detection_basis": {
            "type": "string",
            "enum": [
              "direct_precipitation",
              "precursor_environment",
              "mixed"
            ]
          },
          "precipitation_signal_status": {
            "type": "string",
            "enum": [
              "present",
              "weak",
              "absent",
              "uncertain"
            ]
          },
          "precursor_signal_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "moisture_supply",
                "low_level_forcing",
                "mid_upper_forcing",
                "thermodynamic_support",
                "organization_persistence",
                "direct_precipitation"
              ]
            },
            "maxItems": 6
          },
          "precursor_spatiotemporal_overlap": {
            "type": "boolean"
          },
          "hypothesis": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "spatiotemporal_overlap": {
                "type": "boolean"
              }
            },
            "required": [
              "spatiotemporal_overlap",
              "statement"
            ]
          },
          "analysis_envelope_request": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "temporal_padding_hours": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              }
            },
            "required": [
              "temporal_padding_hours"
            ]
          },
          "diagnostic_plan": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "diagnostic_id": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "diagnostic_id",
                "purpose"
              ]
            },
            "maxItems": 6
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "related_product_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 6
          },
          "related_overview_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 16
          },
          "supporting_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          },
          "opposing_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3
          },
          "separation_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "analysis_envelope_request",
          "candidate_area",
          "candidate_name",
          "confidence",
          "detection_basis",
          "diagnostic_plan",
          "hypothesis",
          "opposing_reasons",
          "peak_forecast_hours",
          "precipitation_signal_status",
          "precursor_signal_categories",
          "precursor_spatiotemporal_overlap",
          "related_overview_asset_ids",
          "related_product_ids",
          "signal_types",
          "supporting_reasons",
          "time_window",
          "uncertainties",
          "separation_reason"
        ]
      },
      "maxItems": 10
    },
    "candidate_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "asset_id": {
                  "type": "string"
                },
                "product_id": {
                  "type": "string"
                },
                "forecast_hours": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "asset_id",
                "forecast_hours",
                "product_id",
                "reason"
              ]
            },
            "maxItems": 12
          }
        },
        "required": [
          "evidence_items"
        ]
      },
      "maxItems": 10
    },
    "precursor_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunity_id",
          "support_asset_ids",
          "representative_forecast_hours",
          "support_categories",
          "qualification",
          "relation_to_direct",
          "related_direct_candidate_ids",
          "relation_basis",
          "candidate_creation",
          "created_candidate_id"
        ],
        "properties": {
          "opportunity_id": {
            "type": "string",
            "pattern": "^PRC_[0-9]{3}$"
          },
          "support_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8
          },
          "representative_forecast_hours": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 8
          },
          "support_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "moisture_supply",
                "low_level_forcing",
                "mid_upper_forcing",
                "thermodynamic_support",
                "organization_persistence"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "qualification": {
            "type": "string",
            "enum": [
              "qualified",
              "not_qualified"
            ]
          },
          "relation_to_direct": {
            "type": "string",
            "enum": [
              "independent",
              "absorbed_into_direct",
              "boundary_ambiguous",
              "not_applicable"
            ]
          },
          "related_direct_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CAND_[0-9]{3}$"
            },
            "maxItems": 10
          },
          "relation_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_relation",
              "spatial_relation",
              "mechanism_relation",
              "reason"
            ],
            "properties": {
              "time_relation": {
                "type": "string"
              },
              "spatial_relation": {
                "type": "string"
              },
              "mechanism_relation": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "candidate_creation": {
            "type": "string",
            "enum": [
              "created",
              "not_created"
            ]
          },
          "created_candidate_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CAND_[0-9]{3}$"
          }
        }
      },
      "maxItems": 10
    },
    "global_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 6
    },
    "package_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis_coverage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "overview_attachment_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "coverage_status",
        "overview_attachment_count"
      ]
    },
    "run_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "candidate_count"
      ]
    },
    "pass2_required": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "precursor_candidate_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_status",
        "qualified_opportunity_count",
        "source_asset_ids",
        "forecast_hours",
        "rationale"
      ],
      "properties": {
        "assessment_status": {
          "type": "string",
          "enum": [
            "qualified_independent_signal",
            "no_qualified_independent_signal"
          ]
        },
        "qualified_opportunity_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "source_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 8
        },
        "forecast_hours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 8
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  },
  "required": [
    "analysis_coverage",
    "candidate_evidence",
    "candidates",
    "global_uncertainties",
    "package_id",
    "pass2_required",
    "run_summary",
    "precursor_opportunities",
    "precursor_candidate_assessment"
  ]
}
