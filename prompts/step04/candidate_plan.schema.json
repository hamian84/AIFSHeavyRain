{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ai_pass1_candidate_plan.schema.json",
  "title": "AI Pass1 후보별 계획 단계",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_analysis_plan",
    "analysis_data_requests"
  ],
  "properties": {
    "candidate_analysis_plan": {
      "$ref": "#/$defs/plan"
    },
    "analysis_data_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "package_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "west",
        "east",
        "south",
        "north"
      ],
      "properties": {
        "west": {
          "type": "number"
        },
        "east": {
          "type": "number"
        },
        "south": {
          "type": "number"
        },
        "north": {
          "type": "number"
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "supporting_check_keys",
        "opposing_check_keys"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "supporting_check_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "opposing_check_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "target_type",
        "resolution_method",
        "requested_domain",
        "region_ids",
        "purpose"
      ],
      "properties": {
        "target_key": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "enum": [
            "candidate_domain",
            "context_domain",
            "operational_regions"
          ]
        },
        "resolution_method": {
          "type": "string",
          "enum": [
            "explicit_bbox",
            "candidate_area_overlap",
            "explicit_region_ids"
          ]
        },
        "requested_domain": {
          "oneOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "region_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target_type": {
                "const": "candidate_domain"
              }
            },
            "required": [
              "target_type"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "explicit_bbox"
              },
              "requested_domain": {
                "$ref": "#/$defs/bbox"
              },
              "region_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_type": {
                "const": "context_domain"
              }
            },
            "required": [
              "target_type"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "explicit_bbox"
              },
              "requested_domain": {
                "$ref": "#/$defs/bbox"
              },
              "region_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_type": {
                "const": "operational_regions"
              },
              "resolution_method": {
                "const": "candidate_area_overlap"
              }
            },
            "required": [
              "target_type",
              "resolution_method"
            ]
          },
          "then": {
            "properties": {
              "requested_domain": {
                "type": "null"
              },
              "region_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolution_method": {
                "const": "explicit_region_ids"
              }
            },
            "required": [
              "resolution_method"
            ]
          },
          "then": {
            "properties": {
              "target_type": {
                "const": "operational_regions"
              },
              "requested_domain": {
                "type": "null"
              },
              "region_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_key",
        "phase_type",
        "forecast_hours",
        "purpose"
      ],
      "properties": {
        "phase_key": {
          "type": "string",
          "minLength": 1
        },
        "phase_type": {
          "type": "string",
          "enum": [
            "pre_peak",
            "peak",
            "post_peak",
            "context"
          ]
        },
        "forecast_hours": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_key",
        "variable_role",
        "required_signal_components",
        "check_scope",
        "diagnostic_id",
        "product_id",
        "feature_ids",
        "target_keys",
        "phase_keys",
        "analysis_methods",
        "expected_signal",
        "decision_relevance",
        "priority",
        "cross_section_line",
        "cross_section_strategy",
        "reference_band_axis"
      ],
      "properties": {
        "check_key": {
          "type": "string",
          "minLength": 1
        },
        "variable_role": {
          "type": "string",
          "enum": [
            "hazard_magnitude",
            "moisture_supply",
            "low_level_forcing",
            "midlevel_forcing",
            "synoptic_support",
            "uncertainty",
            "organization_persistence",
            "thermodynamic_support"
          ]
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "target_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "phase_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "analysis_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "expected_signal": {
          "type": "string",
          "minLength": 1
        },
        "decision_relevance": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "required",
            "supplementary"
          ]
        },
        "diagnostic_id": {
          "type": "string",
          "enum": [
            "detailed_spatial_map",
            "accumulated_precipitation",
            "multivariable_composite",
            "vertical_cross_section",
            "time_height_section",
            "moisture_flux",
            "horizontal_convergence",
            "vertical_wind_shear",
            "temporal_evolution"
          ]
        },
        "cross_section_line": {
          "oneOf": [
            {
              "$ref": "#/$defs/crossSectionLine"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_section_strategy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "across_precipitation_band",
            "along_precipitation_axis",
            "along_moisture_inflow",
            null
          ]
        },
        "reference_band_axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/referenceBandAxis"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_scope": {
          "type": "string",
          "enum": [
            "single_variable",
            "multivariable_alignment",
            "temporal_evolution",
            "vertical_structure"
          ]
        },
        "required_signal_components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "direct_precipitation",
              "moisture_supply",
              "low_level_forcing",
              "mid_upper_forcing",
              "thermodynamic_support",
              "organization_persistence",
              "synoptic_support",
              "uncertainty"
            ]
          },
          "uniqueItems": true
        },
        "intent_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "check_id",
            "source_check_key",
            "signal_components",
            "verification_mode",
            "domain_scope",
            "source_phase_keys",
            "phase_ids",
            "direct_precipitation_anchor",
            "expected_signal",
            "decision_relevance",
            "purpose",
            "priority",
            "evidence_role",
            "coverage_roles",
            "cross_section_line",
            "cross_section_strategy",
            "reference_band_axis",
            "source_intents",
            "merged_source_intent_count"
          ],
          "properties": {
            "contract_version": {
              "type": "string",
              "minLength": 1
            },
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "source_check_key": {
              "type": "string"
            },
            "signal_components": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "verification_mode": {
              "type": "string",
              "minLength": 1
            },
            "domain_scope": {
              "type": "string",
              "minLength": 1
            },
            "source_phase_keys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "phase_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "direct_precipitation_anchor": {
              "type": "boolean"
            },
            "representative_spatial_hours": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            },
            "expected_signal": {
              "type": [
                "string",
                "null"
              ]
            },
            "decision_relevance": {
              "type": [
                "string",
                "null"
              ]
            },
            "purpose": {
              "type": [
                "string",
                "null"
              ]
            },
            "priority": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_role": {
              "type": [
                "string",
                "null"
              ]
            },
            "coverage_roles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "cross_section_line": {
              "type": [
                "object",
                "null"
              ]
            },
            "cross_section_strategy": {
              "type": [
                "string",
                "null"
              ]
            },
            "reference_band_axis": {
              "type": [
                "object",
                "null"
              ]
            },
            "source_intents": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "minItems": 1
            },
            "merged_source_intent_count": {
              "type": "integer",
              "minimum": 1
            },
            "spatial_relation_scope": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "candidate_interior",
                "candidate_boundary_crossing",
                "candidate_external_context",
                "not_applicable",
                null
              ]
            }
          }
        },
        "intent_hash": {
          "type": "string",
          "minLength": 16
        },
        "capability_profile": {
          "type": "object"
        },
        "capability_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "status",
            "warning_codes"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "shadow"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "warning"
              ]
            },
            "warning_codes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "atomic_claim_contract": {
          "type": "object"
        },
        "atomic_claim_hash": {
          "type": "string",
          "minLength": 16
        },
        "atomic_claim_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "status",
            "warning_codes"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "shadow"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "warning"
              ]
            },
            "warning_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "spatial_relation_scope": {
          "type": "string",
          "enum": [
            "candidate_interior",
            "candidate_boundary_crossing",
            "candidate_external_context",
            "not_applicable"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_objective",
        "hypotheses",
        "target_areas",
        "analysis_phases",
        "variable_checks",
        "forecaster_questions"
      ],
      "properties": {
        "analysis_objective": {
          "type": "string",
          "minLength": 1
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/hypothesis"
          }
        },
        "target_areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          },
          "maxItems": 3
        },
        "analysis_phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase"
          },
          "maxItems": 8
        },
        "variable_checks": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "forecaster_questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_type",
        "diagnostic_id",
        "forecast_hours",
        "check_key",
        "target_key",
        "phase_keys",
        "analysis_methods",
        "purpose",
        "priority",
        "cross_section_line",
        "cross_section_strategy",
        "reference_band_axis"
      ],
      "properties": {
        "data_type": {
          "type": "string",
          "enum": [
            "spatial_field",
            "quantitative_excerpt"
          ]
        },
        "diagnostic_id": {
          "type": "string",
          "enum": [
            "detailed_spatial_map",
            "accumulated_precipitation",
            "multivariable_composite",
            "vertical_cross_section",
            "time_height_section",
            "moisture_flux",
            "horizontal_convergence",
            "vertical_wind_shear",
            "temporal_evolution",
            "system_tracking",
            "frontogenesis",
            "q_vector_convergence"
          ]
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forecast_hours": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "requested_domain": {
          "oneOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_key": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "minLength": 1
        },
        "phase_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "analysis_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "output_spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statistics": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "valid_grid_count",
                  "mean",
                  "min",
                  "max",
                  "p95",
                  "max_location",
                  "min_location"
                ]
              },
              "uniqueItems": true
            },
            "ranking_statistic": {
              "type": "string",
              "enum": [
                "mean",
                "max",
                "p95"
              ]
            },
            "top_n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "include_time_series": {
              "type": "boolean"
            },
            "include_max_location": {
              "type": "boolean"
            }
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "required",
            "supplementary"
          ]
        },
        "cross_section_line": {
          "oneOf": [
            {
              "$ref": "#/$defs/crossSectionLine"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_section_strategy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "across_precipitation_band",
            "along_precipitation_axis",
            "along_moisture_inflow",
            null
          ]
        },
        "reference_band_axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/referenceBandAxis"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "data_type": {
                "const": "spatial_field"
              }
            },
            "required": [
              "data_type"
            ]
          },
          "then": {
            "required": [
              "product_id",
              "requested_domain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "data_type": {
                "const": "quantitative_excerpt"
              }
            },
            "required": [
              "data_type"
            ]
          },
          "then": {
            "required": [
              "feature_ids"
            ]
          }
        }
      ]
    },
    "crossSectionLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_latitude",
        "start_longitude",
        "end_latitude",
        "end_longitude",
        "selection_reason"
      ],
      "properties": {
        "start_latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "start_longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "end_latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "end_longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "referenceBandAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_latitude",
        "start_longitude",
        "end_latitude",
        "end_longitude"
      ],
      "properties": {
        "start_latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "start_longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "end_latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "end_longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  }
}
