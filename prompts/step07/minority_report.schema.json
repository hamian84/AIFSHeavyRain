{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIFSHeavyRain Step07 LLM Wiki Minority Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "init",
    "ensemble_contract_version",
    "member_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "step07-llm-wiki-minority-report-v1"
    },
    "init": {
      "type": "string",
      "minLength": 10
    },
    "ensemble_contract_version": {
      "enum": [
        "step07-ensemble-consensus-v1",
        "step07-ensemble-consensus-v2",
        "step07-ensemble-consensus-v3"
      ]
    },
    "member_count": {
      "const": 3
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "assessment": {
      "enum": [
        "observed",
        "partially_observed",
        "not_observed",
        "opposite_observed",
        "uncertain",
        "insufficient_evidence"
      ]
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "count"
      ],
      "properties": {
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "member_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_index",
        "assessment",
        "scope_coverage",
        "spatial_localization",
        "findings",
        "contradictory_findings",
        "uncertainties"
      ],
      "properties": {
        "member_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "scope_coverage": {
          "type": [
            "string",
            "null"
          ]
        },
        "spatial_localization": {
          "type": "object"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "contradictory_findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "check_id",
        "consensus_assessment",
        "assessment_agreement",
        "selected_member_index",
        "vote_counts",
        "localization_agreement",
        "disagreement_severity",
        "disagreement_dimensions",
        "minority_member_indices",
        "member_reports"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "consensus_assessment": {
          "$ref": "#/$defs/assessment"
        },
        "assessment_agreement": {
          "enum": [
            "unanimous",
            "majority",
            "unresolved"
          ]
        },
        "selected_member_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3
        },
        "vote_counts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/vote"
          }
        },
        "localization_agreement": {
          "enum": [
            "unanimous",
            "majority",
            "unresolved",
            "not_applicable"
          ]
        },
        "disagreement_severity": {
          "enum": [
            "minor",
            "material"
          ]
        },
        "disagreement_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "assessment",
              "localization"
            ]
          }
        },
        "minority_member_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "member_reports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/member_report"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disagreement_dimensions": {
                "contains": {
                  "const": "assessment"
                }
              }
            },
            "required": [
              "disagreement_dimensions"
            ]
          },
          "then": {
            "properties": {
              "assessment_agreement": {
                "enum": [
                  "majority",
                  "unresolved"
                ]
              },
              "vote_counts": {
                "minItems": 2,
                "maxItems": 3
              }
            }
          },
          "else": {
            "properties": {
              "assessment_agreement": {
                "const": "unanimous"
              },
              "vote_counts": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
