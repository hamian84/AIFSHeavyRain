{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIFSHeavyRain Step07 Pass2 check results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "init",
    "results"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "step07-pass2-check-results-v3",
        "step07-pass2-check-results-v4",
        "step07-pass2-check-results-v5",
        "step07-pass2-check-results-v6",
        "step07-pass2-check-results-v7",
        "step07-pass2-check-results-v8",
        "step07-pass2-check-results-v10",
        "step07-pass2-check-results-v11",
        "step07-pass2-check-results-v12",
        "step07-pass2-check-results-v13"
      ]
    },
    "init": {
      "type": "string",
      "minLength": 10
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check_result"
      }
    }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "evidence_type",
        "physical_diagnostic",
        "forecast_hour"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "enum": [
            "image",
            "quantitative"
          ]
        },
        "physical_diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "forecast_hour": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "evidence_refs"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "provider_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning_effort",
        "image_detail",
        "prompt_sha256",
        "schema_sha256"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "image_detail": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "minLength": 1
        },
        "schema_sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolved_location": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        }
      }
    },
    "quantitative_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "physical_diagnostic",
        "forecast_hour",
        "region_id",
        "region_name",
        "statistic",
        "resolved_value",
        "units",
        "resolved_location"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_diagnostic": {
          "type": "string",
          "minLength": 1
        },
        "forecast_hour": {
          "type": "integer",
          "minimum": 0
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "region_name": {
          "type": "string",
          "minLength": 1
        },
        "statistic": {
          "enum": [
            "min",
            "max",
            "mean",
            "p95"
          ]
        },
        "resolved_value": {
          "type": "number"
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "resolved_location": {
          "$ref": "#/$defs/resolved_location"
        }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "check_id",
        "expected_signal",
        "decision_relevance",
        "request_ids",
        "available_request_ids",
        "missing_request_ids",
        "evidence_complete",
        "evidence_status",
        "input_fingerprint",
        "assessment",
        "findings",
        "contradictory_findings",
        "quantitative_claims",
        "quantitative_relations",
        "quantitative_consistency_status",
        "usable_for_synthesis",
        "uncertainties",
        "provider_metadata"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_signal": {
          "type": "string",
          "minLength": 1
        },
        "decision_relevance": {
          "type": "string",
          "minLength": 1
        },
        "request_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "available_request_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "missing_request_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_complete": {
          "type": "boolean"
        },
        "evidence_status": {
          "enum": [
            "complete",
            "partial",
            "none"
          ]
        },
        "input_fingerprint": {
          "type": "string",
          "minLength": 16
        },
        "assessment": {
          "enum": [
            "observed",
            "partially_observed",
            "not_observed",
            "opposite_observed",
            "uncertain",
            "insufficient_evidence"
          ]
        },
        "spatial_localization": {
          "$ref": "#/$defs/spatial_localization"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "contradictory_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quantitative_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantitative_claim"
          }
        },
        "provider_metadata": {
          "$ref": "#/$defs/provider_metadata"
        },
        "quantitative_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolved_quantitative_relation"
          }
        },
        "quantitative_consistency_status": {
          "enum": [
            "not_applicable",
            "passed",
            "corrected",
            "failed"
          ]
        },
        "quantitative_consistency_failure_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "QUANTITATIVE_RELATION_MISMATCH",
              "QUANTITATIVE_RELATION_REQUIRED",
              "QUANTITATIVE_FEATURE_USE_INVALID",
              "QUANTITATIVE_SCOPE_CONTRACT_INVALID",
              "QUANTITATIVE_EXPECTED_STATE_MISMATCH"
            ]
          }
        },
        "quantitative_consistency_failure_details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "detail"
            ],
            "properties": {
              "code": {
                "enum": [
                  "QUANTITATIVE_RELATION_MISMATCH",
                  "QUANTITATIVE_RELATION_REQUIRED",
                  "QUANTITATIVE_FEATURE_USE_INVALID",
                  "QUANTITATIVE_SCOPE_CONTRACT_INVALID",
                  "QUANTITATIVE_EXPECTED_STATE_MISMATCH"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "missing_relation_type": {
                "type": "string"
              },
              "required_metric": {
                "type": "string"
              },
              "required_region_id": {
                "type": "string"
              },
              "required_statistic": {
                "type": "string"
              },
              "required_forecast_hours": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required_feature_id": {
                "type": "string",
                "minLength": 1
              },
              "comparison_forecast_hours": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "missing_region_hours": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "majority_total_regions": {
                "type": "integer",
                "minimum": 0
              },
              "not_strengthening_count": {
                "type": "integer",
                "minimum": 0
              },
              "strengthening_count": {
                "type": "integer",
                "minimum": 0
              },
              "strengthening_regions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "not_strengthening_regions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "physical_transitions": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "usable_for_synthesis": {
          "type": "boolean"
        },
        "excluded_from_synthesis_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "INSUFFICIENT_EVIDENCE",
              "QUANTITATIVE_RELATION_MISMATCH",
              "QUANTITATIVE_RELATION_REQUIRED",
              "QUANTITATIVE_FEATURE_USE_INVALID",
              "QUANTITATIVE_SCOPE_CONTRACT_INVALID",
              "QUANTITATIVE_EXPECTED_STATE_MISMATCH",
              "ENSEMBLE_NO_CONSENSUS"
            ]
          }
        },
        "source_intent_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 16
        },
        "intent_contract_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_coverage": {
          "enum": [
            "complete_expected_scope",
            "partial_expected_scope",
            "opposite_expected_scope",
            "indeterminate"
          ]
        },
        "ensemble_consensus": {
          "$ref": "#/$defs/ensemble_consensus"
        },
        "majority_aggregation": {
          "$ref": "#/$defs/majority_aggregation"
        },
        "precipitation_motion": {
          "$ref": "#/$defs/precipitation_motion"
        }
      }
    },
    "spatial_localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "forecast_hour",
        "confidence",
        "regions"
      ],
      "properties": {
        "status": {
          "enum": [
            "localized",
            "indeterminate",
            "not_applicable"
          ]
        },
        "forecast_hour": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            null
          ]
        },
        "regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localized_region"
          }
        }
      }
    },
    "localized_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "relative_sector"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "relative_sector": {
          "enum": [
            "unspecified",
            "north",
            "northeast",
            "east",
            "southeast",
            "south",
            "southwest",
            "west",
            "northwest",
            "central"
          ]
        }
      }
    },
    "resolved_quantitative_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "relation_type",
        "points",
        "claimed_relation",
        "computed_relation",
        "claimed_forecast_hour",
        "computed_forecast_hour",
        "consistency_status"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "enum": [
            "pairwise_comparison",
            "temporal_trend",
            "extremum"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/quantitative_claim"
          }
        },
        "claimed_relation": {
          "enum": [
            "first_greater_than_second",
            "first_less_than_second",
            "approximately_equal",
            "increasing",
            "decreasing",
            "approximately_steady",
            "non_monotonic",
            "maximum_at",
            "minimum_at"
          ]
        },
        "computed_relation": {
          "enum": [
            "first_greater_than_second",
            "first_less_than_second",
            "approximately_equal",
            "increasing",
            "decreasing",
            "approximately_steady",
            "non_monotonic",
            "maximum_at",
            "minimum_at",
            "ambiguous_extremum"
          ]
        },
        "claimed_forecast_hour": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "computed_forecast_hour": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "consistency_status": {
          "enum": [
            "passed",
            "corrected",
            "failed"
          ]
        }
      }
    },
    "assessment_vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "count"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "observed",
            "partially_observed",
            "not_observed",
            "opposite_observed",
            "uncertain",
            "insufficient_evidence"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "ensemble_consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "mode",
        "member_count",
        "assessment_agreement",
        "consensus_assessment",
        "selected_member_index",
        "vote_counts",
        "localization_agreement",
        "disagreement_severity",
        "disagreement_dimensions"
      ],
      "properties": {
        "contract_version": {
          "enum": [
            "step07-ensemble-consensus-v1",
            "step07-ensemble-consensus-v2",
            "step07-ensemble-consensus-v3"
          ]
        },
        "member_count": {
          "enum": [
            0,
            3
          ]
        },
        "assessment_agreement": {
          "enum": [
            "unanimous",
            "majority",
            "unresolved",
            "not_applicable"
          ]
        },
        "consensus_assessment": {
          "enum": [
            "observed",
            "partially_observed",
            "not_observed",
            "opposite_observed",
            "uncertain",
            "insufficient_evidence"
          ]
        },
        "selected_member_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3
        },
        "vote_counts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/assessment_vote"
          }
        },
        "localization_agreement": {
          "enum": [
            "unanimous",
            "majority",
            "unresolved",
            "not_applicable"
          ]
        },
        "disagreement_severity": {
          "enum": [
            "none",
            "minor",
            "material"
          ]
        },
        "disagreement_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "assessment",
              "localization"
            ]
          }
        },
        "mode": {
          "enum": [
            "llm_ensemble",
            "deterministic_insufficient_evidence"
          ]
        },
        "precipitation_motion_agreement": {
          "enum": [
            "unanimous",
            "majority",
            "unresolved",
            "not_applicable"
          ]
        },
        "consensus_precipitation_motion_classification": {
          "enum": [
            "coherent_movement",
            "reorganization",
            "stationary",
            "indeterminate",
            "not_applicable"
          ]
        },
        "precipitation_motion_selected_member_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3
        },
        "precipitation_motion_vote_counts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/precipitation_motion_vote"
          }
        }
      }
    },
    "majority_region_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast_hour",
        "resolved_value",
        "units"
      ],
      "properties": {
        "forecast_hour": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_value": {
          "type": "number"
        },
        "units": {
          "type": "string"
        }
      }
    },
    "majority_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "region_name",
        "physical_transition",
        "strengthening",
        "values"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "region_name": {
          "type": "string",
          "minLength": 1
        },
        "physical_transition": {
          "type": [
            "string",
            "null"
          ]
        },
        "strengthening": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/majority_region_value"
          }
        }
      }
    },
    "majority_aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "feature_id",
        "statistic",
        "forecast_hours",
        "total_regions",
        "not_strengthening_count",
        "strengthening_count",
        "not_strengthening_regions",
        "strengthening_regions",
        "regions"
      ],
      "properties": {
        "contract_version": {
          "const": "candidate-overlap-majority-v1"
        },
        "feature_id": {
          "const": "convergence925_1e5_s"
        },
        "statistic": {
          "const": "mean"
        },
        "forecast_hours": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_regions": {
          "type": "integer",
          "minimum": 1
        },
        "not_strengthening_count": {
          "type": "integer",
          "minimum": 0
        },
        "strengthening_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_strengthening_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strengthening_regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/majority_region"
          }
        }
      }
    },
    "precipitation_motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "origin_region_id",
        "destination_region_id",
        "confidence"
      ],
      "properties": {
        "classification": {
          "enum": [
            "coherent_movement",
            "reorganization",
            "stationary",
            "indeterminate",
            "not_applicable"
          ]
        },
        "origin_region_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "destination_region_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            null
          ]
        }
      }
    },
    "precipitation_motion_vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "count"
      ],
      "properties": {
        "classification": {
          "enum": [
            "coherent_movement",
            "reorganization",
            "stationary",
            "indeterminate",
            "not_applicable"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "step07-pass2-check-results-v7"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "required": [
                "spatial_localization"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "step07-pass2-check-results-v8"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "required": [
                "scope_coverage",
                "spatial_localization",
                "ensemble_consensus"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "step07-pass2-check-results-v13"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "required": [
                "scope_coverage",
                "spatial_localization",
                "precipitation_motion",
                "ensemble_consensus"
              ],
              "properties": {
                "ensemble_consensus": {
                  "required": [
                    "precipitation_motion_agreement",
                    "consensus_precipitation_motion_classification",
                    "precipitation_motion_selected_member_index",
                    "precipitation_motion_vote_counts"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
