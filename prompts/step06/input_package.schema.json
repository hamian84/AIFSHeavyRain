{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIFSHeavyRain Step06 Pass2 source and evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "init",
    "source_of_truth",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "step06-pass2-input-v3"
    },
    "init": {
      "type": "string",
      "minLength": 10
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step04_pass1_result",
        "step05_diagnostics_dir",
        "step05_images_dir",
        "description"
      ],
      "properties": {
        "step04_pass1_result": {
          "type": "string",
          "minLength": 1
        },
        "step05_diagnostics_dir": {
          "type": "string",
          "minLength": 1
        },
        "step05_images_dir": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "candidate_context",
          "analysis_data_requests",
          "check_evidence",
          "exact_evidence_bundles"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_context": {
            "type": "object"
          },
          "analysis_data_requests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "request",
                "step05"
              ],
              "properties": {
                "request": {
                  "type": "object"
                },
                "step05": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "result_path",
                    "status",
                    "result",
                    "generated_images",
                    "missing_reason"
                  ],
                  "properties": {
                    "result_path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "success",
                        "failed",
                        "missing",
                        "invalid"
                      ]
                    },
                    "result": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "generated_images": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "missing_reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "check_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "check_id",
                "diagnostic_id",
                "variable_role",
                "expected_signal",
                "decision_relevance",
                "priority",
                "request_ids",
                "available_request_ids",
                "missing_request_ids",
                "evidence_complete",
                "evidence_status",
                "cross_section_context",
                "time_height_context",
                "bundle_id",
                "check_scope",
                "required_signal_components",
                "available_signal_components",
                "missing_signal_components",
                "allowed_quantitative_forecast_hours"
              ],
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1
                },
                "diagnostic_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "variable_role": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "expected_signal": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "decision_relevance": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "priority": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "request_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "available_request_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "missing_request_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "evidence_complete": {
                  "type": "boolean"
                },
                "evidence_status": {
                  "enum": [
                    "complete",
                    "partial",
                    "none"
                  ]
                },
                "cross_section_context": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "time_height_context": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "bundle_id": {
                  "type": "string",
                  "minLength": 1
                },
                "check_scope": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "single_variable",
                    "multivariable_alignment",
                    "temporal_evolution",
                    "vertical_structure",
                    null
                  ]
                },
                "required_signal_components": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "direct_precipitation",
                      "moisture_supply",
                      "low_level_forcing",
                      "mid_upper_forcing",
                      "thermodynamic_support",
                      "organization_persistence",
                      "synoptic_support",
                      "uncertainty"
                    ]
                  },
                  "uniqueItems": true
                },
                "available_signal_components": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "direct_precipitation",
                      "moisture_supply",
                      "low_level_forcing",
                      "mid_upper_forcing",
                      "thermodynamic_support",
                      "organization_persistence",
                      "synoptic_support",
                      "uncertainty"
                    ]
                  },
                  "uniqueItems": true
                },
                "missing_signal_components": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "direct_precipitation",
                      "moisture_supply",
                      "low_level_forcing",
                      "mid_upper_forcing",
                      "thermodynamic_support",
                      "organization_persistence",
                      "synoptic_support",
                      "uncertainty"
                    ]
                  },
                  "uniqueItems": true
                },
                "allowed_quantitative_forecast_hours": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "source_intent_hash": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 16
                },
                "intent_contract_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_atomic_claim_hash": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "atomic_claim_contract_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "atomic_claim_validation_status": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "pass",
                    "warning",
                    null
                  ]
                }
              }
            }
          },
          "exact_evidence_bundles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bundle_id",
                "request_ids",
                "check_ids",
                "image_count",
                "quantitative_request_count"
              ],
              "properties": {
                "bundle_id": {
                  "type": "string",
                  "minLength": 1
                },
                "request_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "check_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "image_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "quantitative_request_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
