        "evidence_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localized_region"
          }
