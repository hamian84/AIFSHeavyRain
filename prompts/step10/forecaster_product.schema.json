          "properties": {
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            }
          }
        },
        "object_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "operational_overlap_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "localized"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "forecast_hour": {
                "type": "integer",
                "minimum": 0
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "evidence_check_ids": {
                "minItems": 1
              },
              "regions": {
                "minItems": 1
              },
              "source": {
                "const": "step07_validated_spatial_localization"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "precipitation_object"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "forecast_hour": {
                "type": "integer",
                "minimum": 0
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "evidence_check_ids": {
                "minItems": 1
              },
              "regions": {
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/localized_region"
                    },
                    {
                      "required": [
                        "coverage_class",
                        "object_relation",
                        "region_role",
                        "precip_coverage_fraction",
                        "object_overlap_fraction",
                        "overlap_grid_count"
                      ]
                    }
                  ]
                }
              },
              "source": {
                "const": "system_precipitation_object"
              }
            },
            "required": []
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "discovery_envelope"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "forecast_hour": {
                "type": "null"
              },
              "confidence": {
                "type": "null"
              },
              "evidence_check_ids": {
                "maxItems": 0
              },
              "regions": {
                "maxItems": 0
              },
              "source": {
                "const": "step04_candidate_area"
              }
            }
