{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm_wiki_result.schema.json",
  "title": "AIFSHeavyRain LLM Wiki v1 stored result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wiki_id",
    "init",
    "before_analysis_id",
    "after_analysis_id",
    "comparability_status",
    "grounding_sha256",
    "generated_at_utc",
    "explanation",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "llm-wiki-result-v1"},
    "wiki_id": {"type": "string", "pattern": "^WIKI_[0-9]{10}_[A-F0-9]{12}$"},
    "init": {"type": "string", "pattern": "^[0-9]{10}$"},
    "before_analysis_id": {"type": "string", "minLength": 1},
    "after_analysis_id": {"type": "string", "minLength": 1},
    "comparability_status": {
      "type": "string",
      "enum": ["same_condition", "condition_changed", "partially_comparable", "not_comparable"]
    },
    "grounding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "explanation": {"$ref": "#/$defs/explanation"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "evidence_ref": {
      "type": "string",
      "enum": [
        "comparability",
        "mandatory_direct_signal",
        "step04.precursor",
        "step04.candidates",
        "step04_provenance.before",
        "step04_provenance.after",
        "step07",
        "step08",
        "step09",
        "step10"
      ]
    },
    "explanation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "explanation", "evidence_refs"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "change_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "change_type", "explanation", "evidence_refs"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "change_type": {"type": "string", "enum": ["changed", "added", "removed", "uncertain", "condition_changed"]},
        "explanation": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/evidence_ref"}}
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_summary",
        "maintained_judgments",
        "changed_judgments",
        "evidence_changes",
        "contradictions_and_uncertainties",
        "forecaster_attention",
        "limitations"
      ],
      "properties": {
        "overall_summary": {"type": "string", "minLength": 1},
        "maintained_judgments": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/explanation_item"}},
        "changed_judgments": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/change_item"}},
        "evidence_changes": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/explanation_item"}},
        "contradictions_and_uncertainties": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/explanation_item"}},
        "forecaster_attention": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/explanation_item"}},
        "limitations": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning_effort",
        "prompt_sha256",
        "response_schema_sha256",
        "comparison_schema_version",
        "response_id",
        "request_id",
        "retry_count",
        "usage"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "comparison_schema_version": {"type": "string", "minLength": 1},
        "response_id": {"type": ["string", "null"]},
        "request_id": {"type": ["string", "null"]},
        "retry_count": {"type": "integer", "minimum": 0},
        "usage": {"type": ["object", "null"]}
      }
    }
  }
}
